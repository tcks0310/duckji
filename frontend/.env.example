# ==============================================================================
# DUCKJI frontend 환경변수 — .env.local 로 복사해서 사용
# NEXT_PUBLIC_ 값은 빌드 결과(브라우저)에 그대로 포함되므로 비밀값을 넣으면 안 됩니다.
# 비밀값(Client Secret, 관리자 비밀번호 등)은 backend/.env 에 넣으세요.
# ==============================================================================

# backend API 주소
NEXT_PUBLIC_API_URL=http://localhost:4000

# 사이트 주소 (관리자 > 팝업 관리 > 현장 QR 이 가리킬 주소). 비우면 관리자 페이지를 연 주소를 사용
NEXT_PUBLIC_SITE_URL=https://duckji.com

# Google OAuth (Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Naver OAuth (Naver Developers) — Client Secret 은 backend 에서 사용
NEXT_PUBLIC_NAVER_CLIENT_ID=your_naver_client_id_here

# Kakao JavaScript SDK (Kakao Developers) — 카카오 로그인
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key_here

# 네이버 지도 (네이버 클라우드 플랫폼 > Maps > Application 등록) — 한국어 화면의 지도
# Dynamic Map 체크, Web 서비스 URL 에 사이트 도메인(로컬은 http://localhost:3000) 등록 후 Client ID 입력
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Google Maps JavaScript API (Google Cloud Console) — 영어·일본어·중국어 화면의 지도
# 결제 계정 연결 필요. API 키는 HTTP 리퍼러(사이트 도메인)로 제한해 두세요.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Tarot / MBTI Event Key (Default: 0922*)
NEXT_PUBLIC_TAROT_SECRET_KEY=0922*

# Supabase (Optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
