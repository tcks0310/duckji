# ==============================================================================
# DUCKJI backend 환경변수 — .env 로 복사해서 사용 (로컬), 배포 시에는 Lambda 환경변수/SSM 으로 설정
# ==============================================================================

PORT=4000

# 띄울 서비스 (쉼표 구분, 비우면 전체). 컨테이너로 서비스 하나만 띄울 때 사용 예: SERVICES=users
SERVICES=

# 프론트엔드 주소 (CORS 허용, 쉼표로 여러 개)
FRONTEND_ORIGIN=http://localhost:3000

# 관리자 (/admin 로그인) — 반드시 강한 비밀번호로 설정
ADMIN_ID=admin
ADMIN_PASSWORD=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# PostgreSQL (RDS). 비워두면 메모리 저장소로 동작 (재시작 시 데이터 사라짐)
DATABASE_URL=
# (커뮤니티 gallery·board·community-points 서비스는 DB 가 꼭 필요합니다)

# 회원 로그인 세션 서명 키 — auth·users·gallery·board·community-points 모두 같은 값
# 예: openssl rand -hex 32  (비우면 로컬에서는 임시 키, 운영에서는 회원 로그인 불가)
MEMBER_SESSION_SECRET=

# 소셜 토큰 검증 (토큰이 우리 앱에서 발급됐는지 확인, auth 서비스)
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=

# 커뮤니티 이미지 업로드 (board 서비스)
# local: backend/.uploads 에 저장 (개발용) / s3: S3 서명 URL 로 브라우저가 직접 업로드 (운영)
UPLOAD_DRIVER=local
UPLOAD_BUCKET=
UPLOAD_REGION=ap-northeast-2
# 업로드된 이미지 공개 주소 (운영: https://www.duckji.com — CloudFront 의 community/* 경로가 업로드 버킷)
UPLOAD_PUBLIC_BASE_URL=http://localhost:4000/api/galleries/member-uploads/local

# 팝업 자동 수집 후보를 받을 때 확인하는 토큰 (popups 서비스, 예: openssl rand -hex 32)
POPUP_COLLECTOR_TOKEN=
